{
  "name": "open-fleet-mobile-sync",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "A standalone fleet workflow demonstrator and proposed mobile synchronisation project.",
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web --localhost",
    "build:web": "expo export --platform web",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "check": "npm run typecheck && npm test && npm run build:web"
  },
  "dependencies": {
    "@expo-google-fonts/barlow": "^0.4.1",
    "@expo-google-fonts/barlow-condensed": "^0.4.1",
    "@expo-google-fonts/ibm-plex-mono": "^0.4.1",
    "@expo/metro-runtime": "~57.0.15",
    "expo": "^57.0.22",
    "expo-font": "~57.0.4",
    "expo-haptics": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "~19.2.4",
    "typescript": "~6.0.3"
  },
  "overrides": {
    "xcode": {
      "uuid": "11.1.1"
    }
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
